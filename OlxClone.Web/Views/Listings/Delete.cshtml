@model OlxClone.Web.Models.Listing
@{
    ViewData["Title"] = "Изтрий обява";
    var cover = Model.Images.OrderBy(i => i.SortOrder).FirstOrDefault();
}

<h1 class="h3 mb-4">Изтриване на обява</h1>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <p>Сигурен ли си, че искаш да изтриеш обявата <strong>"@Model.Title"</strong>? Това действие е необратимо и ще изтрие и всички качени снимки.</p>

                <div class="d-flex align-items-center gap-3 mb-4">
                    @if (cover != null)
                    {
                        <img src="/uploads/listings/@Model.Id/@cover.FileName" class="thumb rounded" alt="" />
                    }
                    <div>
                        <div class="fw-semibold">@Model.Title</div>
                        <div class="text-muted small"><i class="bi bi-eye"></i> @Model.ViewCount прегледа</div>
                    </div>
                </div>

                <form asp-controller="Listings" asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Да, изтрий</button>
                    <a asp-controller="Listings" asp-action="MyListings" class="btn btn-outline-secondary">Отказ</a>
                </form>
            </div>
        </div>
    </div>
</div>
