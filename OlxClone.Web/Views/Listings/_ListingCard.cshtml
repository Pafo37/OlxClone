@model ListingCardViewModel

<div class="col-sm-6 col-lg-4">
    <div class="listing-card position-relative">
        <div class="listing-card__image">
            @if (Model.CoverImageUrl != null)
            {
                <img src="@Model.CoverImageUrl" alt="@Model.Title" loading="lazy" />
            }
            else
            {
                <div class="listing-card__placeholder"><i class="bi bi-image"></i></div>
            }
            <form asp-controller="Favorites" asp-action="Toggle" method="post" class="listing-card__fav-form">
                <input type="hidden" name="listingId" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit" class="listing-card__fav-btn" title="Любими">
                    <i class="bi @(Model.IsFavorite ? "bi-heart-fill text-danger" : "bi-heart")"></i>
                </button>
            </form>
        </div>
        <div class="listing-card__body">
            <h3 class="listing-card__title">
                <a class="stretched-link text-reset text-decoration-none" asp-controller="Listings" asp-action="Details" asp-route-id="@Model.Id">
                    @Model.Title
                </a>
            </h3>
            <div class="listing-card__meta">
                <span><i class="bi bi-eye"></i> @Model.ViewCount</span>
                <span>@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
            </div>
        </div>
    </div>
</div>
