@model ListingCardViewModel

<div class="col-sm-6 col-lg-4">
    <div class="card h-100">
        <div class="position-relative">
            @if (Model.CoverImageUrl != null)
            {
                <img src="@Model.CoverImageUrl" class="card-img-top listing-photo" alt="@Model.Title" loading="lazy"/>
            }
            else
            {
                <div class="card-img-top listing-photo bg-light d-flex align-items-center justify-content-center">
                    <i class="bi bi-image fs-1 text-secondary"></i>
                </div>
            }
            @if (!User.IsInRole("Admin"))
            {
                <form asp-controller="Favorites" asp-action="Toggle" method="post"
                      class="position-absolute top-0 end-0 m-2 z-2">
                    <input type="hidden" name="listingId" value="@Model.Id"/>
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString"/>
                    <button type="submit" class="btn btn-light btn-sm rounded-circle" title="Любими">
                        <i class="bi @(Model.IsFavorite ? "bi-heart-fill text-danger" : "bi-heart")"></i>
                    </button>
                </form>
            }
        </div>
        <div class="card-body d-flex flex-column">
            <h3 class="h6 mb-1">
                <a class="stretched-link text-reset text-decoration-none" asp-controller="Listings" asp-action="Details"
                   asp-route-id="@Model.Id">
                    @Model.Title
                </a>
            </h3>
            <div class="fw-bold fs-5">@Model.Price.ToString("0.00") €</div>
            <div class="mt-auto pt-2 d-flex justify-content-between small text-muted">
                <span><i class="bi bi-eye"></i> @Model.ViewCount</span>
                <span>@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
            </div>
        </div>
    </div>
</div>
