@model OlxClone.Web.Models.ViewModels.ListingEditViewModel
@{
    ViewData["Title"] = "Редактирай обява";
}

<h1 class="h3 mb-4">Редактирай обява</h1>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <form asp-controller="Listings" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" novalidate>
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="6"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    @if (Model.ExistingImages.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label">Текущи снимки</label>
                            <div class="row g-2">
                                @foreach (var img in Model.ExistingImages)
                                {
                                    <div class="col-4 col-md-3">
                                        <div class="card">
                                            <img src="@img.Url" class="card-img-top thumb w-100" style="height: 90px;" alt="" />
                                            <div class="card-body p-2">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="ImageIdsToDelete" value="@img.Id" id="del-@img.Id" />
                                                    <label class="form-check-label small text-danger" for="del-@img.Id">Премахни</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="mb-4">
                        <label asp-for="NewImages" class="form-label"></label>
                        <input type="file" name="NewImages" class="form-control" multiple accept="image/png,image/jpeg,image/webp,image/gif" />
                    </div>

                    <div class="alert alert-info">
                        След редакция обявата ще бъде изпратена за повторно одобрение.
                    </div>

                    <button type="submit" class="btn btn-success">Запази промените</button>
                    <a asp-controller="Listings" asp-action="MyListings" class="btn btn-outline-secondary">Отказ</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
