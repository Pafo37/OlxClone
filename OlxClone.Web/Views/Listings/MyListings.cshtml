@model List<Listing>
@{
    ViewData["Title"] = "Моите обяви";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h1 class="h3 mb-0">Моите обяви</h1>
    <a class="btn btn-success" asp-controller="Listings" asp-action="Create">
        <i class="bi bi-plus-lg"></i> Нова обява
    </a>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-card-list fs-1"></i>
            <p class="mt-3 mb-0">Все още нямаш публикувани обяви.</p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th></th>
                        <th>Заглавие</th>
                        <th>Цена</th>
                        <th>Статус</th>
                        <th><i class="bi bi-eye"></i> Прегледи</th>
                        <th>Публикувана на</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var listing in Model)
                    {
                        var cover = listing.Images.OrderBy(i => i.SortOrder).FirstOrDefault();
                        <tr>
                            <td>
                                @if (cover != null)
                                {
                                    <img src="/uploads/listings/@listing.Id/@cover.FileName" class="thumb rounded" alt="" />
                                }
                                else
                                {
                                    <span class="text-secondary"><i class="bi bi-image fs-4"></i></span>
                                }
                            </td>
                            <td>
                                <a asp-controller="Listings" asp-action="Details" asp-route-id="@listing.Id" class="fw-semibold text-reset text-decoration-none">
                                    @listing.Title
                                </a>
                            </td>
                            <td class="fw-semibold text-nowrap">@listing.Price.ToString("0.00") €</td>
                            <td>
                                @switch (listing.Status)
                                {
                                    case ListingStatus.Approved:
                                        <span class="badge text-bg-success">Одобрена</span>
                                        break;
                                    case ListingStatus.Pending:
                                        <span class="badge text-bg-warning">Чака одобрение</span>
                                        break;
                                    case ListingStatus.Rejected:
                                        <span class="badge text-bg-danger" title="@listing.RejectionReason">Отказана</span>
                                        break;
                                }
                            </td>
                            <td>@listing.ViewCount</td>
                            <td>@listing.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Listings" asp-action="Edit" asp-route-id="@listing.Id">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a class="btn btn-sm btn-outline-danger" asp-controller="Listings" asp-action="Delete" asp-route-id="@listing.Id">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}