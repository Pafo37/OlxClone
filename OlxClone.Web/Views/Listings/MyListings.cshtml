@model List<Listing>
@{
    ViewData["Title"] = "Моите обяви";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h1 class="h3 mb-0">Моите обяви</h1>
    <a class="btn btn-brand" asp-controller="Listings" asp-action="Create"><i class="bi bi-plus-lg"></i> Нова обява</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-card-list"></i>
        <p>Все още нямаш публикувани обяви.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle my-listings-table">
            <thead>
                <tr>
                    <th></th>
                    <th>Заглавие</th>
                    <th>Статус</th>
                    <th><i class="bi bi-eye"></i> Прегледи</th>
                    <th>Публикувана на</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var listing in Model)
                {
                    var cover = listing.Images.OrderBy(i => i.SortOrder).FirstOrDefault();
                    <tr>
                        <td style="width:64px;">
                            @if (cover != null)
                            {
                                <img src="/uploads/listings/@listing.Id/@cover.FileName" class="my-listing-thumb" alt="" />
                            }
                            else
                            {
                                <div class="my-listing-thumb my-listing-thumb--empty"><i class="bi bi-image"></i></div>
                            }
                        </td>
                        <td>
                            <a asp-controller="Listings" asp-action="Details" asp-route-id="@listing.Id" class="fw-semibold text-reset text-decoration-none">
                                @listing.Title
                            </a>
                        </td>
                        <td>
                            @switch (listing.Status)
                            {
                                case ListingStatus.Approved:
                                    <span class="badge status-badge status-badge--approved">Одобрена</span>
                                    break;
                                case ListingStatus.Pending:
                                    <span class="badge status-badge status-badge--pending">Чака одобрение</span>
                                    break;
                                case ListingStatus.Rejected:
                                    <span class="badge status-badge status-badge--rejected" title="@listing.RejectionReason">Отказана</span>
                                    break;
                            }
                        </td>
                        <td>@listing.ViewCount</td>
                        <td>@listing.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Listings" asp-action="Edit" asp-route-id="@listing.Id">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a class="btn btn-sm btn-outline-danger" asp-controller="Listings" asp-action="Delete" asp-route-id="@listing.Id">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
