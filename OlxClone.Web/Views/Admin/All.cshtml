@model List<Listing>
@{
    ViewData["Title"] = "Всички обяви";
    var currentFilter = ViewBag.StatusFilter as string;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h1 class="h3 mb-0"><i class="bi bi-list-ul"></i> Всички обяви</h1>
    <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Pending"><i class="bi bi-shield-check"></i> За одобрение</a>
</div>

<div class="btn-group mb-4" role="group">
    <a class="btn btn-sm @(currentFilter == null ? "btn-brand" : "btn-outline-secondary")" asp-controller="Admin" asp-action="All">Всички</a>
    <a class="btn btn-sm @(currentFilter == "Pending" ? "btn-brand" : "btn-outline-secondary")" asp-controller="Admin" asp-action="All" asp-route-statusFilter="Pending">Чакащи</a>
    <a class="btn btn-sm @(currentFilter == "Approved" ? "btn-brand" : "btn-outline-secondary")" asp-controller="Admin" asp-action="All" asp-route-statusFilter="Approved">Одобрени</a>
    <a class="btn btn-sm @(currentFilter == "Rejected" ? "btn-brand" : "btn-outline-secondary")" asp-controller="Admin" asp-action="All" asp-route-statusFilter="Rejected">Отказани</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-inboxes"></i>
        <p>Няма обяви в тази категория.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle my-listings-table">
            <thead>
                <tr>
                    <th></th>
                    <th>Заглавие</th>
                    <th>Потребител</th>
                    <th>Статус</th>
                    <th><i class="bi bi-eye"></i></th>
                    <th>Дата</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var listing in Model)
                {
                    var cover = listing.Images.OrderBy(i => i.SortOrder).FirstOrDefault();
                    <tr>
                        <td style="width:64px;">
                            @if (cover != null)
                            {
                                <img src="/uploads/listings/@listing.Id/@cover.FileName" class="my-listing-thumb" alt="" />
                            }
                            else
                            {
                                <div class="my-listing-thumb my-listing-thumb--empty"><i class="bi bi-image"></i></div>
                            }
                        </td>
                        <td>
                            <a asp-controller="Listings" asp-action="Details" asp-route-id="@listing.Id" class="fw-semibold text-reset text-decoration-none">
                                @listing.Title
                            </a>
                        </td>
                        <td>@(listing.User?.FullName ?? "-")</td>
                        <td>
                            @switch (listing.Status)
                            {
                                case ListingStatus.Approved:
                                    <span class="badge status-badge status-badge--approved">Одобрена</span>
                                    break;
                                case ListingStatus.Pending:
                                    <span class="badge status-badge status-badge--pending">Чака одобрение</span>
                                    break;
                                case ListingStatus.Rejected:
                                    <span class="badge status-badge status-badge--rejected">Отказана</span>
                                    break;
                            }
                        </td>
                        <td>@listing.ViewCount</td>
                        <td>@listing.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Listings" asp-action="Delete" asp-route-id="@listing.Id">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
