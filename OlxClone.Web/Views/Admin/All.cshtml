@model List<OlxClone.Web.Models.Listing>
@{
    ViewData["Title"] = "Всички обяви";
    var currentFilter = ViewBag.StatusFilter as string;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h1 class="h3 mb-0">Всички обяви</h1>
    <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Pending">За одобрение</a>
</div>

<div class="btn-group mb-4">
    <a class="btn btn-sm @(currentFilter == null ? "btn-success" : "btn-outline-secondary")" asp-controller="Admin" asp-action="All">Всички</a>
    <a class="btn btn-sm @(currentFilter == "Pending" ? "btn-success" : "btn-outline-secondary")" asp-controller="Admin" asp-action="All" asp-route-statusFilter="Pending">Чакащи</a>
    <a class="btn btn-sm @(currentFilter == "Approved" ? "btn-success" : "btn-outline-secondary")" asp-controller="Admin" asp-action="All" asp-route-statusFilter="Approved">Одобрени</a>
    <a class="btn btn-sm @(currentFilter == "Rejected" ? "btn-success" : "btn-outline-secondary")" asp-controller="Admin" asp-action="All" asp-route-statusFilter="Rejected">Отказани</a>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-inbox fs-1"></i>
            <p class="mt-3 mb-0">Няма обяви в тази категория.</p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th></th>
                        <th>Заглавие</th>
                        <th>Потребител</th>
                        <th>Статус</th>
                        <th><i class="bi bi-eye"></i></th>
                        <th>Дата</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var listing in Model)
                    {
                        var cover = listing.Images.OrderBy(i => i.SortOrder).FirstOrDefault();
                        <tr>
                            <td>
                                @if (cover != null)
                                {
                                    <img src="/uploads/listings/@listing.Id/@cover.FileName" class="thumb rounded" alt="" />
                                }
                                else
                                {
                                    <span class="text-secondary"><i class="bi bi-image fs-4"></i></span>
                                }
                            </td>
                            <td>
                                <a asp-controller="Listings" asp-action="Details" asp-route-id="@listing.Id" class="fw-semibold text-reset text-decoration-none">
                                    @listing.Title
                                </a>
                            </td>
                            <td>@(listing.User?.FullName ?? "-")</td>
                            <td>
                                @switch (listing.Status)
                                {
                                    case ListingStatus.Approved:
                                        <span class="badge text-bg-success">Одобрена</span>
                                        break;
                                    case ListingStatus.Pending:
                                        <span class="badge text-bg-warning">Чака одобрение</span>
                                        break;
                                    case ListingStatus.Rejected:
                                        <span class="badge text-bg-danger">Отказана</span>
                                        break;
                                }
                            </td>
                            <td>@listing.ViewCount</td>
                            <td>@listing.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-danger" asp-controller="Listings" asp-action="Delete" asp-route-id="@listing.Id">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
