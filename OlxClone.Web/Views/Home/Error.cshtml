@model OlxClone.Web.Models.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "Грешка";
}

<div class="text-center py-5">
    <h1 class="h3"><i class="bi bi-exclamation-triangle text-warning"></i> Възникна грешка</h1>
    <p class="text-muted">Извинявайте, нещо се обърка при обработката на заявката.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-success" asp-controller="Listings" asp-action="Index">Обратно към обявите</a>
</div>
