@model ErrorViewModel
@{
    ViewData["Title"] = "Грешка";
}

<div class="text-center py-5">
    <h1 class="display-5"><i class="bi bi-exclamation-triangle text-warning"></i> Възникна грешка</h1>
    <p class="text-muted">Извинявайте, нещо се обърка при обработката на заявката.</p>
    @if (Model.ShowRequestId)
    {
        <p><small class="text-muted">Request ID: <code>@Model.RequestId</code></small></p>
    }
    <a class="btn btn-brand" asp-controller="Listings" asp-action="Index">Обратно към обявите</a>
</div>
